{
    "extends": "$app/tsconfig",
    "compilerOptions": {
        "strict": true,
        "types": ["$app/types", "node", "bun"],
        "paths": {
            "#components": ["./src/components/index.ts"],
            "#components/*": ["./src/components/*"],
            "#lib": ["./src/lib/index.ts"],
            "#lib/*": ["./src/lib/*"],
            "#server": ["./src/server/index.ts"],
            "#server/*": ["./src/server/*"],
            "#messages/*": ["./src/messages/*"],
            "#static/*": ["./static/*"]
        }
    },
    "include": [
        ".no-push/scriptsh/scripts",
        "src",
        "tests",
        "eslint.config.ts",
        "mdsvex.config.ts",
        "prettier.config.ts",
        "vite.config.ts"
    ],
    "exclude": ["src/service-worker"]
}
