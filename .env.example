# Copy to .env and fill in. .env is gitignored — real values never enter the repo.
# On Vercel, set the same names in the project's environment settings.

# Upstash (Vercel KV) REST API — used by the encrypted server links (/api/share).
# Either the UPSTASH_KV_REST_API_* pair (manual Upstash database) or the
# VERCEL_KV_REST_API_* pair (KV store attached in Vercel) works.
UPSTASH_KV_REST_API_URL=
UPSTASH_KV_REST_API_TOKEN=
UPSTASH_KV_REST_API_READ_ONLY_TOKEN=
# VERCEL_KV_REST_API_URL=
# VERCEL_KV_REST_API_TOKEN=

# Imprint (Impressum) — rendered on /legal/impressum (name + address of the
# Verantwortlicher, § 5 DDG). Keep out of the source code.
IMPRESSUM_NAME=
IMPRESSUM_STREET=
IMPRESSUM_ZIP=
IMPRESSUM_CITY=
IMPRESSUM_COUNTRY=
IMPRESSUM_EMAIL=
