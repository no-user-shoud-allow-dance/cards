{
    "name": "nsc",
    "version": "2.0.0",
    "private": true,
    "description": "NSC — local-first flashcard app for vocabulary learning with the Leitner spaced-repetition system. SvelteKit + Svelte 5 + Bun; all data stays in the browser.",
    "homepage": "https://github.com/no-user-shoud-allow-dance/cards",
    "bugs": "https://github.com/no-user-shoud-allow-dance/cards/issues",
    "repository": "git+https://github.com/no-user-shoud-allow-dance/cards.git",
    "license": "MIT",
    "author": "NoUserShoudAllowDance <nousad@web.de>",
    "type": "module",
    "imports": {
        "#components": "./src/components/index.ts",
        "#components/*": "./src/components/*",
        "#lib": "./src/lib/index.ts",
        "#lib/*": "./src/lib/*",
        "#server": "./src/server/index.ts",
        "#server/*": "./src/server/*",
        "#messages/*": "./src/messages/*",
        "#static/*": "./static/*"
    },
    "scripts": {
        "build": "vite build",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "dev": "vite dev",
        "fix": "bun run format && eslint --fix .",
        "format": "bunx sort-package-json && prettier --write .",
        "lint": "prettier --check . && eslint .",
        "prepare": "svelte-kit sync || echo ''",
        "preview": "vite preview",
        "test": "bun test"
    },
    "dependencies": {
        "detectincognitojs": "^1.9.0",
        "peerjs": "^1.5.5",
        "qr-code-styling": "^1.9.2"
    },
    "devDependencies": {
        "@csstools/postcss-color-mix-function": "^4.0.17",
        "@eslint/js": "^10.0.1",
        "@prettier/plugin-xml": "^3.4.2",
        "@sveltejs/adapter-vercel": "^7.0.4",
        "@sveltejs/kit": "^3.3.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@types/node": "^26.6.6",
        "autoprefixer": "^10.6.2",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.24.1",
        "eslint-plugin-tsdoc": "^0.5.4",
        "globals": "^17.14.0",
        "jiti": "^2.7.0",
        "mdsvex": "^0.12.8",
        "postcss": "^8.5.33",
        "postcss-color-converter": "^1.2.1",
        "postcss-each": "^1.1.0",
        "postcss-nesting": "^14.0.3",
        "postcss-simple-vars": "^7.0.1",
        "prettier": "^3.10.1",
        "prettier-plugin-markdown-html": "^1.6.2",
        "prettier-plugin-sh": "^0.20.2",
        "prettier-plugin-svelte": "^4.2.0",
        "sharp": "^0.35.5",
        "svelte": "^5.58.0",
        "svelte-check": "^4.7.8",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.3.8"
    }
}
